{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "SETUP.md",
      "package.json",
      "package-lock.json",
      "index.txt",
      "무제.rtf",
      "일본IT취업_목표트래커.xlsx",
      "일본어 카루가루1_OCR 복사본.pdf",
      "카루가루 일본어_OCR 복사본.pdf",
      "wntnfghlwjs.jpg",
      "bnt.jpg"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
